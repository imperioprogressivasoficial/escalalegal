# ===== Escala Legal — configuração do VPS =====
# O deploy/instalar.sh cria o .env sozinho com senhas fortes. Este arquivo é só referência.

# Domínio (ou subdomínio) apontado para o IP do VPS com um registro A
DOMAIN=escala.seudominio.com.br

# Segredos: troque por valores longos e aleatórios
DB_PASS=
SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASS=
WEBHOOK_TOKEN=

# Link do checkout de R$ 47 (Kiwify, Hotmart, Cakto, Clickmax...)
CHECKOUT_URL=

# WhatsApp do suporte, com DDI e DDD (aparece na página de obrigado e nos e-mails)
SUPORTE_WHATSAPP=5571999999999

# E-mail que entrega o acesso (SMTP). Exemplo Hostinger: smtp.hostinger.com, porta 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Escala Legal <acesso@seudominio.com.br>

# Opcional: webhook do n8n que recebe cadastro, lead e compra (com o link de acesso, para mandar no WhatsApp)
N8N_WEBHOOK_URL=
# Opcional: ID do Pixel do Meta (só números)
META_PIXEL_ID=

# Porta local do app (só o VPS enxerga). Mude se a 3010 já estiver em uso.
APP_PORT=3010

# Só para testes: 1 libera o gerador para todos sem pagamento
LIBERAR_TUDO=0
