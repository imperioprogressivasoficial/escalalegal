# ===== Sua Escala 5x2 — configuração do VPS =====
# O deploy/instalar.sh cria o .env sozinho com senhas fortes. Este arquivo é só referência.

# Domínio (ou subdomínio) apontado para o IP do VPS com um registro A
DOMAIN=suaescala5x2.com.br

# Segredos: troque por valores longos e aleatórios
DB_PASS=
SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASS=
WEBHOOK_TOKEN=

# Link do checkout de R$ 97 (Kiwify, Hotmart, Cakto, Clickmax...)
CHECKOUT_URL=

# WhatsApp do suporte, com DDI e DDD (aparece na página de obrigado e nos e-mails)
SUPORTE_WHATSAPP=5571999999999

# E-mail que entrega o acesso (SMTP). Exemplo Hostinger: smtp.hostinger.com, porta 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sua Escala 5x2 <acesso@suaescala5x2.com.br>

# Opcional: webhook do n8n que recebe cadastro, lead e compra (com o link de acesso, para mandar no WhatsApp)
N8N_WEBHOOK_URL=
# ---------- Anúncios e medição (só carregam depois que a pessoa aceita os cookies) ----------
# Pixel da Meta (só números) e o token da API de Conversões (Gerenciador de Eventos > Configurações > Gerar token)
META_PIXEL_ID=
META_CAPI_TOKEN=
# Código de teste do Gerenciador de Eventos (só enquanto testa; depois apague)
META_TEST_EVENT_CODE=
# Google Analytics 4 (G-XXXXXXX) e/ou Google Tag Manager (GTM-XXXXXXX)
GA_ID=
GTM_ID=
# Verificação de domínio: Google Search Console (só o código do content) e Meta Business
GOOGLE_SITE_VERIFICATION=
META_DOMAIN_VERIFICATION=

# ---------- Dados da empresa (rodapé, política de privacidade e termos) ----------
EMPRESA_RAZAO_SOCIAL=
EMPRESA_CNPJ=
EMPRESA_EMAIL=
EMPRESA_CIDADE=

# Porta local do app (só o VPS enxerga). Mude se a 3010 já estiver em uso.
APP_PORT=3010

# Só para testes: 1 libera o gerador para todos sem pagamento
LIBERAR_TUDO=0

# Indicação: sem comissão (0). Para ligar, quem indica ganha COMISSAO_PERCENT % do PRECO por compra aprovada (pago por Pix pelo /admin)
PRECO=97
COMISSAO_PERCENT=0
