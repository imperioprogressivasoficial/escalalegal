# Senhas e segredos — troque por valores fortes e diferentes
DB_PASS=troque-esta-senha-do-banco
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha-do-painel
